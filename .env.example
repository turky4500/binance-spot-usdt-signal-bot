TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me
TIMEZONE=Asia/Riyadh
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_QUOTE_ASSET=USDT
BINANCE_INTERVAL=1h
POLL_SECONDS=60
# 499 = أقصى حد يبقى فيه وزن طلب Binance لـ klines = 2 (مطلوب لـ Target Trend: warmup ~400 شمعة)
KLINE_LIMIT=499
REQUEST_TIMEOUT=20
MAX_WORKERS=10
HALAL_REFRESH_HOURS=6
STATE_FILE=data/state.json
LOG_LEVEL=INFO
# ── Target Trend [BigBeluga] — المؤشر المعتمد الوحيد ──
TREND_LENGTH=10
TREND_TARGET_OFFSET=0
EXCLUDE_PEGGED_STABLES=1
