TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me
TIMEZONE=Asia/Riyadh
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_QUOTE_ASSET=USDT
BINANCE_INTERVAL=4h
POLL_SECONDS=60
# 499 = أقصى حد يبقى فيه وزن طلب Binance لـ klines = 2 (warmup ~400 شمعة من الفريم النشط)
KLINE_LIMIT=499
REQUEST_TIMEOUT=20
MAX_WORKERS=10
HALAL_REFRESH_HOURS=6
STATE_FILE=data/state.json
LOG_LEVEL=INFO
# ── Target Trend [BigBeluga] — المؤشر المعتمد الوحيد ──
TREND_LENGTH=89
TREND_TARGET_OFFSET=0
# ── بوابة الدراسة فوق الإشارة (أُعيد ضبطها لفريم 4H 2026-10-15) ──
ENTRY_ER_MIN=0.20
ENTRY_ER_LEN=14
ENTRY_COOLDOWN_HOURS=96
EXCLUDE_PEGGED_STABLES=1

# ── نظام Smart Flow PRO MAX (نسخة معايَرة/موازية) — انظر README_SMARTFLOW.md ──
SMARTFLOW_STATE_FILE=data/state_smartflow.json
SMARTFLOW_HALAL_DIR=data/smartflow
SMARTFLOW_SIGNALS_LOG=data/smartflow/signals_log.csv
SMARTFLOW_KLINE_LIMIT=200
SMARTFLOW_MAX_CATCHUP_HOURS=24
SMARTFLOW_EMA_LEN=20
SMARTFLOW_EMA_SLOW_LEN=50
SMARTFLOW_EMA_FAST_LEN=10
SMARTFLOW_SMA_LEN=20
SMARTFLOW_RSI_LEN=14
SMARTFLOW_BUY_RSI_MIN=45
SMARTFLOW_SELL_RSI_MAX=45
SMARTFLOW_USE_RSI_GATE=0
SMARTFLOW_BREAK_LEN=10
SMARTFLOW_ATR_LEN=14
SMARTFLOW_SIGNAL_MODE=on_flip
SMARTFLOW_COOLDOWN_BARS=6
SMARTFLOW_CALIBRATION_NOTE=1
SMARTFLOW_DRY_RUN=0
SMARTFLOW_ALTERNATE=1
