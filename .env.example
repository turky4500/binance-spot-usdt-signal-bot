TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me
TIMEZONE=Asia/Riyadh
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_QUOTE_ASSET=USDT
BINANCE_INTERVAL=4h
POLL_SECONDS=60
# 499 = أقصى حد يبقى فيه وزن طلب Binance لـ klines = 2 (warmup ~400 شمعة من الفريم النشط)
KLINE_LIMIT=499
REQUEST_TIMEOUT=20
MAX_WORKERS=10
HALAL_REFRESH_HOURS=6
STATE_FILE=data/state.json
LOG_LEVEL=INFO
# ── Target Trend [BigBeluga] — المؤشر المعتمد الوحيد ──
TREND_LENGTH=89
TREND_TARGET_OFFSET=0
# ── بوابة الدراسة فوق الإشارة (أُعيد ضبطها لفريم 4H 2026-10-15) ──
ENTRY_ER_MIN=0.20
ENTRY_ER_LEN=14
ENTRY_COOLDOWN_HOURS=96
EXCLUDE_PEGGED_STABLES=1
# ── ZigZag++ (ساعة) — نظام مستقل، مسارات منفصلة ──
ZZ_STATE_FILE=data/state_zigzag.json
ZZ_HALAL_DIR=data/zigzag
ZZ_DEPTH=12
ZZ_TARGET_PCT=2
ZZ_DOJI_BODY_PCT=0.05
ZZ_LOOKBACK_BARS=6
ZZ_MAX_ENTRY_AGE_HOURS=2
# فلتر اختياري: أدنى مسافة بين الدخول وقاع الإشارة % (0 = معطّل — المعتمد حاليًا)
ZZ_MIN_STOP_PCT=0
ZZ_COMMISSION_SIDE_PCT=0.1
# فلتر المتوسط 200: لا إشارة إلا فوق EMA200 (1 = مفعّل، 0 = معطّل) — 2026-10-30
ZZ_EMA_FILTER=1
ZZ_EMA_LEN=200
# قائمة استبعاد يدوية (أسهم مرمّزة/ذهب/رموز غير مرغوبة) — سطر لكل رمز، «#» للتعليقات
ZZ_EXCLUDE_FILE=config/zz_exclude.txt
# استبعاد آلي لكل أصل تنتهي قاعدته بحرف B (أسهم/صناديق مرمّزة: SPYB, NVDAB, JPMB)
ZZ_EXCLUDE_B_SUFFIX=1
# تجميع الرسائل: رسالة واحدة لكل نوع في الدورة (لا رسالة لكل عملة)
ZZ_MSG_BATCH_MAX_ITEMS=12
ZZ_MSG_BATCH_MAX_CHARS=3500
# أقل فاصل بين رسالتين تيليجرام (ثانية) — 0 = بلا فاصل
TELEGRAM_MIN_INTERVAL_SECONDS=1.05
# إسكات إرسال تيليجرام مؤقتًا مع استمرار العمل: 1 = مُسكت، 0 = يرسل
TELEGRAM_MUTE=0
