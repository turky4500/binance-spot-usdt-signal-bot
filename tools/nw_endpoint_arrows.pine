// =============================================================================
// NW Endpoint Arrows — مرآة مرئية لبوت Nadaraya-Watson على TradingView
// -----------------------------------------------------------------------------
// هذا عمل مشتق من "Nadaraya-Watson Smoothers [LuxAlgo]" © LuxAlgo،
// مرخّص تحت CC BY-NC-SA 4.0:
// https://creativecommons.org/licenses/by-nc-sa/4.0/
// الأصل: https://www.tradingview.com/script/amRCTgFw-Nadaraya-Watson-Smoothers-LuxAlgo/
//
// لماذا يوجد هذا الملف؟
// ---------------------
// في مؤشر LuxAlgo، عند تعطيل "Repainting Smoothing" (repaint=false) يُرسم
// **خط سببي فقط ولا يُرسم أي مثلث ▲/▼** (توثيق LuxAlgo الرسمي). البوت يستخدم
// هذا الوضع السببي، ويُطبّق قاعدة المثلثات نفسها (d*y1_d<0) على الخط. لذلك لا
// يوجد سهم أخضر على الشارت يطابق رسائل البوت — وهذا بالضبط ما لاحظه المستخدم.
//
// هذا السكربت يحسب الخط السببي بنفس معادلة LuxAlgo بالحرف، ثم يرسم ▲/▼ بنفس
// قاعدة src/nw_signals.py::_evaluate_endpoint:
//
//   d[B]   = out[B]   - out[B-1]
//   d[B+1] = out[B+1] - out[B]
//   d[B] < 0  و  d[B+1] > 0   ⇒ ▲ على الشمعة B (تُعرف عند إغلاق B+1)
//   d[B] > 0  و  d[B+1] < 0   ⇒ ▼ على الشمعة B
//
// البوت يفحص لون الشمعة B+1: خضراء ⇒ توصية دخول بسعر إغلاقها و🕒 = وقتها؛
// حمراء ⇒ تُلغى نهائيًا. السهم هنا يُرسم بغض النظر عن اللون (كما في Pine)،
// لذا قد ترى ▲ لم تُرسل منه توصية لأن شمعته التالية أغلقت حمراء.
//
// طريقة الاستعمال: أضف السكربت إلى شارت **BINANCE spot** و**فريم 1H**،
// واضبط منطقة الزمن على Asia/Riyadh إن أردت مطابقة 🕒 في الرسائل،
// واترك h=8 و Source=close كما في البوت. يحتاج ≥500 شمعة تاريخية.
// ملاحظة: بعض أزواج Binance (الأسهم المرمّزة مثل AAPLBUSDT) قد لا تتوفر
// على TradingView أو قد تختلف بياناتها عن بينانس.
// =============================================================================

//@version=5
indicator("NW Endpoint Arrows (Bot Mirror)", shorttitle="NW Arrows", overlay=true,
     max_bars_back=500, max_labels_count=500)

// ── إعدادات مطابقة للبوت ────────────────────────────────────────────────────
h        = input.float(8., "Bandwidth  =  NW_BANDWIDTH", minval=0.1, step=0.1)
src      = input.source(close, "Source  =  close")
showLine = input.bool(true, "Show endpoint line")
upCss    = input.color(#39ff14, "▲ color")
dnCss    = input.color(#ff1100, "▼ color")

// ── نفس دالة gauss في Pine الأصلية ──────────────────────────────────────────
gauss(x, h) => math.exp(-(math.pow(x, 2) / (h * h * 2)))

// ── endpoint Nadaraya-Watson estimator (repaint=false) ─────────────────────
// out = Σ src[i] * gauss(i,h) / Σ gauss(i,h)   ,   i = 0..499 (ماضٍ فقط)
var array<float> coefs = array.new_float(0)
var float den = 0.
if barstate.isfirst
    for i = 0 to 499
        coefs.push(gauss(i, h))
    den := coefs.sum()

float out = na
if bar_index >= 499
    float acc = 0.
    for i = 0 to 499
        acc += src[i] * coefs.get(i)
    out := acc / den

// ── قاعدة الانعطاف (مطابقة لـ endpoint_flip_signals في البوت) ─────────────
// على الشمعة الحالية t = B+1:  out[2]=out[B-1], out[1]=out[B], out=out[B+1]
d_prev = out[1] - out[2]        // d[B]   = out[B]   - out[B-1]
d_now  = out    - out[1]        // d[B+1] = out[B+1] - out[B]

// barstate.isconfirmed ⇒ لا إعادة رسم: التسمية تظهر عند إغلاق الشمعة وتبقى.
confirmed = barstate.isconfirmed and not na(out) and not na(out[1]) and not na(out[2])
isBuy  = confirmed and d_prev < 0 and d_now > 0
isSell = confirmed and d_prev > 0 and d_now < 0

// offset=-1 يضع السهم على الشمعة B لا على شمعة الاكتشاف B+1.
plot(showLine ? out : na, "NW endpoint", color=color.new(color.teal, 0), linewidth=2)
plotshape(isBuy ? low[1] : na, "▲ Buy", shape.labelup, location.absolute,
     color=color.new(color.lime, 100), text="▲", textcolor=upCss,
     offset=-1, size=size.tiny)
plotshape(isSell ? high[1] : na, "▼ Sell", shape.labeldown, location.absolute,
     color=color.new(color.red, 100), text="▼", textcolor=dnCss,
     offset=-1, size=size.tiny)

alertcondition(isBuy,  "NW ▲ Buy",  "NW endpoint trough — تحقق من لون الشمعة التالية")
alertcondition(isSell, "NW ▼ Sell", "NW endpoint peak")
